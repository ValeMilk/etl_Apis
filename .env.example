# PostgreSQL Database
DB_URL=postgresql+psycopg2://bi_user:bi_password@localhost:5432/bi_cometa
DATABASE_ECHO=false

# API Cometa
API_BASE_URL=https://vendas.cometasupermercados.com.br
API_EMAIL=seu_email@example.com
API_PASSWORD=sua_senha
VERIFY_SSL=false
REQUEST_TIMEOUT=30

# Application
LOG_LEVEL=INFO
ETL_INTERVAL_MINUTES=5

# FastAPI
APP_HOST=0.0.0.0
APP_PORT=8000

# Security (REQUIRED)
API_AUTH_TOKEN=your-secure-bearer-token-here-change-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
