FROM python:3.10-slim

# Environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install dependencies
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r /app/requirements.txt

# Copy application code
COPY src/ /app/

# Copy entrypoint script
COPY docker/entrypoint-etl.sh /app/entrypoint-etl.sh
RUN chmod +x /app/entrypoint-etl.sh

# Create non-root user
RUN useradd -m -u 1001 etluser && \
    chown -R etluser:etluser /app

# Switch to non-root user
USER etluser

# ETL worker entry point with bootstrap
ENTRYPOINT ["/app/entrypoint-etl.sh"]
